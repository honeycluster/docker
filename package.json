{
  "name": "nodekit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@nx/js": "22.6.1",
    "concurrently": "^9.2.1",
    "nx": "22.6.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "pnpm nx:prepack && pnpm nx:build",
    "build:deps": "node ./bin/build-deps.js",
    "--------------------------": "",
    "test": "pnpm nx:prepack && pnpm nx:test",
    "lint": "pnpm nx:prepack && pnpm nx:lint",
    "format": "pnpm nx:prepack && pnpm nx:format",
    "prepack": "pnpm nx:prepack",
    "affected": "pnpm nx:affected",
    "----------------------------": "",
    "nx:affected": "pnpm run env -- nx affected -t build",
    "nx:dev": "pnpm run env -- nx run-many -t dev",
    "nx:build": "pnpm run env -- nx run-many -t build",
    "nx:prepack": "pnpm run env -- nx run-many -t prepack",
    "nx:test": "pnpm run env -- nx run-many -t test",
    "nx:lint": "nx run-many -t lint",
    "nx:format": "nx run-many -t format",
    "--------------------------------": "",
    "release": "nx release --yes",
    "release:first": "nx release --first-release --yes",
    "release:alpha": "nx release --specifier prerelease --preid a --yes",
    "release:beta": "nx release --specifier prerelease --preid b --yes",
    "release:rc": "nx release --specifier prerelease --preid rc --yes",
    "release:dry": "nx release --first-release --dry-run"
  }
}
