{
    "database": {
        "type": "cassandra",
        "cassandra": {
            "contact_points": "10.201.0.10",
            "port": 9042,
            "keyspace": "clio",
            "replication_factor": 1,
            "table_prefix": "",
            "max_write_requests_outstanding": 25000,
            "max_read_requests_outstanding": 30000,
            "threads": 8,
            "core_connections_per_host": 1,
            "write_batch_size": 20
        }
    },
    "allow_no_etl": false,
    "etl_sources": [
        {
            "ip": "10.201.0.3",
            "ws_port": "6006",
            "grpc_port": "50051"
        }
    ],
    "forwarding": {
        "cache_timeout": 0.25,
        "request_timeout": 10.0
    },
    "rpc": {
        "cache_timeout": 0.5
    },
    "dos_guard": {
        "whitelist": [
            "127.0.0.1"
        ],
        "max_fetches": 1000000,
        "max_connections": 20,
        "max_requests": 20,
        "sweep_interval": 1
    },
    "server": {
        "ip": "0.0.0.0",
        "port": 51233,
        "max_queue_size": 500,
        "admin_password": "xrp",
        "local_admin": false,
        "processing_policy": "parallel",
        "parallel_requests_limit": 10,
        "ws_max_sending_queue_size": 1500,
        "proxy": {
            "ips": [],
            "tokens": []
        }
    },
    "graceful_period": 10.0,
    "log": {
        "channels": [
            {
                "channel": "Backend",
                "level": "fatal"
            },
            {
                "channel": "WebServer",
                "level": "info"
            },
            {
                "channel": "Subscriptions",
                "level": "info"
            },
            {
                "channel": "RPC",
                "level": "error"
            },
            {
                "channel": "ETL",
                "level": "debug"
            },
            {
                "channel": "Performance",
                "level": "trace"
            }
        ],
        "level": "info",
        "format": "%Y-%m-%d %H:%M:%S.%f %^%3!l:%n%$ - %v",
        "is_async": true,
        "enable_console": true,
        "rotation_size": 2048,
        "directory_max_files": 25,
        "tag_style": "uint"
    },
    "cache": {
        "num_diffs": 32,
        "num_markers": 48,
        "page_fetch_size": 512,
        "load": "async"
    },
    "prometheus": {
        "enabled": true,
        "compress_reply": true
    },
    "extractor_threads": 8,
    "read_only": false,
    "api_version": {
        "min": 1,
        "max": 2,
        "default": 1
    }
}
