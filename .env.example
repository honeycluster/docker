# Required for pnpm release (publish to npm + create GitHub release)
# Copy to .env and fill in your tokens

# npm registry auth - create at https://www.npmjs.com/settings/~/tokens
NODE_AUTH_TOKEN=

# GitHub token for automatic release creation - create at https://github.com/settings/tokens
# Needs 'repo' scope for private repos, or 'public_repo' for public repos
GITHUB_TOKEN=
