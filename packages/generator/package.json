{
  "name": "@honeycluster/xrpld-cfg-gen",
  "version": "0.0.1-a.3",
  "description": "TypeScript config generator for xrpld.cfg — presets, validation, multi-format input",
  "type": "module",
  "license": "MIT",
  "author": "honeycluster <r@honeycluster.io>",
  "homepage": "https://github.com/honeycluster/nodekit/tree/main/packages/generator",
  "repository": {
    "type": "git",
    "url": "https://github.com/honeycluster/nodekit.git",
    "directory": "packages/generator"
  },
  "bugs": {
    "url": "https://github.com/honeycluster/nodekit/issues"
  },
  "keywords": [
    "xrpl",
    "xrpld",
    "rippled",
    "xrp-ledger",
    "config-generator",
    "docker",
    "blockchain",
    "node-config"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/esm/src/index.js",
  "types": "./dist/esm/src/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "examples"
  ],
  "bin": {
    "xrpld-cfg-gen": "./dist/esm/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/esm/src/index.d.ts",
      "import": "./dist/esm/src/index.js",
      "require": "./dist/cjs/src/index.js"
    }
  },
  "scripts": {
    "prebuild": "rm -rf ./dist && rm -rf ./build",
    "postbuild": "echo 'Gen built successfully!'",
    "c:esm": "tsc -P config/tsconfig.esm.json && tsc-alias -p config/tsconfig.esm.json",
    "c:cjs": "tsc -P config/tsconfig.cjs.json && tsc-alias -p config/tsconfig.cjs.json",
    "c": "pnpm run c:cjs && pnpm run c:esm",
    "build": "pnpm prebuild && pnpm run c && pnpm postbuild",
    "rebuild": "pnpm run c && pnpm postbuild",
    "lint": "eslint src --report-unused-disable-directives",
    "format": "prettier 'src' --write --list-different --config ./config/prettier.config.cjs",
    "format:check": "prettier 'src' --check --config ./config/prettier.config.cjs",
    "test": "vitest run",
    "testOne": "vitest run"
  },
  "prettier": "./config/prettier.config.cjs",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@honeycluster/configs": "workspace:^",
    "@types/node": "catalog:",
    "prettier": "catalog:",
    "tsc-alias": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
